
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------
// ENUMS
// ------------------------------------------------

enum UserRole {
  SHIPPER
  CARRIER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TruckStatus {
  ACTIVE
  INACTIVE
}

enum EquipmentType {
  OPEN_BODY
  CONTAINER
  FLATBED
  REFRIGERATED
  OTHER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELLED
}

enum BookingStatus {
  PENDING_APPROVAL
  CONFIRMED
  IN_TRANSIT
  COMPLETED
  REJECTED
  CANCELLED
  EXPIRED
}

// ------------------------------------------------
// USERS
// ------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String
  phone        String?
  companyName  String?
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trucks   Truck[]
  loads    Load[]
  bookings Booking[] @relation("ShipperBookings")

  @@index([role, status])
}

// ------------------------------------------------
// TRUCKS
// ------------------------------------------------

model Truck {
  id                 String        @id @default(uuid()) @db.Uuid
  carrierId          String        @db.Uuid
  registrationNumber String        @unique
  equipmentType      EquipmentType
  maxWeightKg        Decimal       @db.Decimal(12, 2)
  maxVolumeM3        Decimal?      @db.Decimal(12, 3)
  status             TruckStatus   @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  carrier   User       @relation(fields: [carrierId], references: [id])
  emptyLegs EmptyLeg[]

  @@index([carrierId, status])
}

// ------------------------------------------------
// EMPTY TRUCK JOURNEYS
// ------------------------------------------------

model EmptyLeg {
  id        String @id @default(uuid()) @db.Uuid
  truckId   String @db.Uuid

  originName      String
  destinationName String

  originLat      Decimal? @db.Decimal(10, 7)
  originLng      Decimal? @db.Decimal(10, 7)
  destinationLat Decimal? @db.Decimal(10, 7)
  destinationLng Decimal? @db.Decimal(10, 7)

  departureAt DateTime
  arrivalAt   DateTime?

  availableWeightKg Decimal  @db.Decimal(12, 2)
  availableVolumeM3 Decimal? @db.Decimal(12, 3)

  maxDetourKm Decimal @default(0) @db.Decimal(8, 2)

  acceptedCargoTypes String[] @default([])

  status ListingStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  truck    Truck      @relation(fields: [truckId], references: [id])
  stops    LegStop[]
  bookings Booking[]

  @@index([status, departureAt])
  @@index([truckId, status])
}

// ------------------------------------------------
// ORDERED INTERMEDIATE ROUTE STOPS
// ------------------------------------------------

model LegStop {
  id         String @id @default(uuid()) @db.Uuid
  emptyLegId String @db.Uuid

  sequence   Int
  placeName  String
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  arrivalAt  DateTime?

  emptyLeg EmptyLeg @relation(fields: [emptyLegId], references: [id], onDelete: Cascade)

  @@unique([emptyLegId, sequence])
}

// ------------------------------------------------
// SHIPPER LOADS
// ------------------------------------------------

model Load {
  id        String @id @default(uuid()) @db.Uuid
  shipperId String @db.Uuid

  pickupName  String
  deliveryName String

  pickupLat   Decimal? @db.Decimal(10, 7)
  pickupLng   Decimal? @db.Decimal(10, 7)
  deliveryLat Decimal? @db.Decimal(10, 7)
  deliveryLng Decimal? @db.Decimal(10, 7)

  cargoDescription String
  cargoType        String

  weightKg Decimal  @db.Decimal(12, 2)
  volumeM3 Decimal? @db.Decimal(12, 3)

  pickupWindowStart   DateTime
  pickupWindowEnd     DateTime
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?

  requiredEquipment EquipmentType?

  status ListingStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shipper  User      @relation(fields: [shipperId], references: [id])
  bookings Booking[]

  @@index([shipperId, status])
  @@index([status, pickupWindowStart])
}

// ------------------------------------------------
// BOOKINGS
// ------------------------------------------------

model Booking {
  id         String @id @default(uuid()) @db.Uuid

  loadId     String @db.Uuid
  emptyLegId String @db.Uuid
  shipperId  String @db.Uuid

  status BookingStatus @default(PENDING_APPROVAL)

  requestedWeightKg Decimal  @db.Decimal(12, 2)
  requestedVolumeM3 Decimal? @db.Decimal(12, 3)

  pickupName   String
  deliveryName String

  quotedPriceInr    Decimal? @db.Decimal(12, 2)
  dedicatedPriceInr Decimal? @db.Decimal(12, 2)
  platformFeeInr    Decimal? @db.Decimal(12, 2)

  estimatedCo2SavedKg Decimal? @db.Decimal(12, 3)

  expiresAt DateTime

  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  pickedUpAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  load     Load     @relation(fields: [loadId], references: [id])
  emptyLeg EmptyLeg @relation(fields: [emptyLegId], references: [id])
  shipper  User     @relation("ShipperBookings", fields: [shipperId], references: [id])

  @@index([emptyLegId, status])
  @@index([shipperId, status])
  @@index([status, expiresAt])
  @@index([loadId])
}
